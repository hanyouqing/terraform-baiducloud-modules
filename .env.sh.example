#!/usr/bin/env bash
# Copy to .env.sh (gitignored) and source before terraform/terragrunt.
#   cp .env.sh.example .env.sh && chmod 600 .env.sh && source .env.sh

export BAIDUCLOUD_ACCESS_KEY="${BAIDUCLOUD_ACCESS_KEY:-}"
export BAIDUCLOUD_SECRET_KEY="${BAIDUCLOUD_SECRET_KEY:-}"
export BAIDUCLOUD_REGION="${BAIDUCLOUD_REGION:-bj}"

# Optional: BOS S3-compatible endpoint for Terragrunt remote state
# export BAIDUCLOUD_BOS_ENDPOINT="https://s3.${BAIDUCLOUD_REGION}.bcebos.com"

# Optional overrides used by Terragrunt compute stack
# export TF_VAR_image_id="m-xxxxxxxx"
# export TF_VAR_keypair_id="k-xxxxxxxx"
# export TF_VAR_account_name="personal"
